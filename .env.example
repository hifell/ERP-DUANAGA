# Salin ke .env lalu isi dengan nilai rahasia asli.
# JANGAN commit .env — sudah masuk .gitignore.

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
PGDATA=/var/lib/postgresql/data/pgdata

# ── Odoo ─────────────────────────────────────────────────────────────────
ODOO_MASTER_PASSWD=CHANGE_ME_master_password
ODOO_URL=http://localhost:8069
ODOO_DB=duanaga
ODOO_USER=admin
ODOO_PASSWORD=CHANGE_ME_odoo_admin_password

# ── n8n ──────────────────────────────────────────────────────────────────
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_basic_auth_password
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678

# ── Telegram Bot ─────────────────────────────────────────────────────────
# Ambil dari @BotFather. Kalau pernah ter-commit, ROTASI token ini.
TELEGRAM_BOT_TOKEN=CHANGE_ME_telegram_bot_token
# Allowlist Telegram user id yang boleh memakai bot (pisahkan koma).
TELEGRAM_ALLOWED_USER_IDS=

# ── QC Integration API ───────────────────────────────────────────────────
# Kunci untuk endpoint /qc_integration/api/v1/qc-check (header X-Api-Key).
# Harus diisi, kalau kosong endpoint menolak semua request.
QC_INTEGRATION_API_KEY=CHANGE_ME_qc_api_key

# ── QC Engine ────────────────────────────────────────────────────────────
QC_API_KEY=CHANGE_ME_qc_engine_api_key
