            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Submitted Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved Message": {
      "main": [
        [
          {
            "node": "Pending Info Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submitted Message": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pending Info Message": {
      "main": [
        [
          {
            "node": "Rejected Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Rejected Message": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "Odoo - Mark WA Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "timeout": 300
  },
  "staticData": null,
  "tags": ["bpom", "whatsapp", "automation", "regulatory"],
