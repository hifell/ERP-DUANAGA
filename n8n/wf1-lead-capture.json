    {
      "parameters": {
        "jsCode": "// Parse incoming data\nconst data = $input.first().json;\n\nconst leadData = {\n  name: data.name || 'Website Lead',\n  contact_name: data.contact_name || data.name || '',\n  email_from: data.email || '',\n  phone: data.phone || '',\n  description: `Product: ${data.product || 'N/A'}\\nQuantity: ${data.quantity || 'N/A'}\\n\\n${data.message || ''}`,\n  type: 'lead'\n};\n\nreturn [{ json: leadData }];"
      },
      "name": "Parse Data",
      "type": "n8n-nodes-base.code",
      "position": [470, 300]
    },
    {
      "parameters": {
        "url": "=http://erp_duanaga_odoo:8069/jsonrpc/2/object",
        "method": "POST",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"call\",\n  \"params\": {\n    \"service\": \"object\",\n    \"method\": \"execute_kw\",\n    \"args\": [\n      \"duanaga\",\n      2,\n      \"admin\",\n      \"crm.lead\",\n      \"create\",\n      [{{ $json }}]\n    ]\n  }\n}",
        "options": {}
      },
      "name": "Create Lead in Odoo",
