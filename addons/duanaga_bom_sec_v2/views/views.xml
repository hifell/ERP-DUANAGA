<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_form" model="ir.ui.view">
        <field name="name">product.template.form.bomsec</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="bomsec" string="BoM Security">
                    <group>
                        <field name="material_code"/>
                        <field name="is_confidential_material"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_bom_form" model="ir.ui.view">
        <field name="name">mrp.bom.form.bomsec</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="is_confidential"/>
                <field name="formula_code"/>
            </xpath>
        </field>
    </record>
</odoo>
