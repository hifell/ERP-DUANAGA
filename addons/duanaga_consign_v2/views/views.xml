<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form_consign" model="ir.ui.view">
        <field name="name">stock.location.form.consign</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='return_location']" position="after">
                <group name="consignment">
                    <field name="is_consignment"/>
                    <field name="consignment_owner_id" invisible="is_consignment == False"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_product_form_consign" model="ir.ui.view">
        <field name="name">product.template.form.consign</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="after">
                <page name="consignment" string="Consignment" invisible="type != 'product'">
                    <group>
                        <field name="is_consignment"/>
                        <field name="consignment_owner_id" invisible="is_consignment == False"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
