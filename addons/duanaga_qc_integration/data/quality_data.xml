<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action: QC KBR Decision List -->
    <record id="action_qc_kbr_decision" model="ir.actions.act_window">
        <field name="name">KBR QC Decisions</field>
        <field name="res_model">qc.kbr.decision</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada keputusan QC.
            </p>
            <p>
                Buat dari Production Order → QC Tests
            </p>
        </field>
    </record>

    <!-- Action: Create KBR Decision (for button in Production Order) -->
    <record id="action_create_kbr_decision" model="ir.actions.act_window">
        <field name="name">Create KBR Decision</field>
        <field name="res_model">qc.kbr.decision</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
