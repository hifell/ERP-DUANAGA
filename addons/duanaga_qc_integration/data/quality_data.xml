<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sequence untuk nomor referensi keputusan QC -->
        <record id="seq_qc_kbr_decision" model="ir.sequence">
            <field name="name">QC KBR Decision</field>
            <field name="code">qc.kbr.decision</field>
            <field name="prefix">QC/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Action: QC KBR Decision List -->
        <record id="action_qc_kbr_decision" model="ir.actions.act_window">
            <field name="name">KBR QC Decisions</field>
            <field name="res_model">qc.kbr.decision</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_draft': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Belum ada keputusan QC.
                </p>
                <p>
                    Buat dari Production Order → QC Tests
                </p>
            </field>
        </record>

    </data>
</odoo>
