<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Tree View ─────────────────────────────────────────── -->
    <record id="view_qc_kbr_decision_tree" model="ir.ui.view">
        <field name="name">qc.kbr.decision.tree</field>
        <field name="model">qc.kbr.decision</field>
        <field name="arch" type="xml">
            <tree decoration-success="status=='approved'"
                  decoration-warning="status=='rework'"
                  decoration-danger="status=='rejected'"
                  decoration-muted="state=='draft'"
                  create="1"
                  edit="1">
                <field name="name" string="Ref"/>
                <field name="create_date" string="Date"/>
                <field name="production_id" string="Production Order"/>
                <field name="batch_id" string="Batch"/>
                <field name="product_id" string="Product"/>
                <field name="ph_level"/>
                <field name="viscosity"/>
                <field name="status" widget="badge"
                       decoration-success="status=='approved'"
                       decoration-warning="status=='rework'"
                       decoration-danger="status=='rejected'"/>
                <field name="user_id" string="Analyst"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ─── Form View ─────────────────────────────────────────── -->
    <record id="view_qc_kbr_decision_form" model="ir.ui.view">
        <field name="name">qc.kbr.decision.form</field>
        <field name="model">qc.kbr.decision</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Status badge based on KBR result -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,done"/>

                    <button name="submit_to_kbr"
                            string="Submit to KBR Engine"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"
                            confirm="Kirim data ke Inference Engine?"/>

                    <button name="submit_to_kbr"
                            string="Re-evaluate"
                            type="object"
                            invisible="state not in ('done', 'failed')"
                            confirm="Evaluasi ulang batch?"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group col="4">
                        <!-- Production Info -->
                        <group string="Production" colspan="2">
                            <field name="production_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="qty_produced" readonly="1"/>
                            <field name="qty_approved" readonly="1"
                                   invisible="not qty_approved"/>
                        </group>

                        <!-- QC Input -->
                        <group string="QC Parameters" colspan="2">
                            <field name="ph_level"
                                   readonly="state == 'done'"/>
                            <field name="ph_min" readonly="1"/>
                            <field name="ph_max" readonly="1"/>
                            <field name="viscosity"
                                   readonly="state == 'done'"/>
                            <field name="visc_min" readonly="1"/>
                            <field name="visc_max" readonly="1"/>
                        </group>
                    </group>

                    <!-- KBR Result -->
                    <group string="KBR Decision" col="4"
                           invisible="state not in ('done', 'failed')">
                        <group colspan="2">
                            <field name="status" readonly="1"
                                   widget="badge"
                                   decoration-success="status=='approved'"
                                   decoration-warning="status=='rework'"
                                   decoration-danger="status=='rejected'"
                                   class="fs-5"/>
                            <field name="ph_in_range" readonly="1"/>
                            <field name="viscosity_in_range" readonly="1"/>
                        </group>
                        <group colspan="2">
                            <field name="recommendation"
                                   readonly="1"
                                   widget="text"/>
                        </group>
                    </group>

                    <!-- Raw Debug -->
                    <group string="Debug"
                           colspan="4"
                           invisible="not api_response_raw">
                        <field name="api_response_raw"
                               readonly="1"
                               widget="text"
                               style="font-family: monospace; font-size: 11px;"/>
                    </group>

                    <!-- Audit -->
                    <group col="2">
                        <group>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ─── Search View ──────────────────────────────────────── -->
    <record id="view_qc_kbr_decision_search" model="ir.ui.view">
        <field name="name">qc.kbr.decision.search</field>
        <field name="model">qc.kbr.decision</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <filter name="draft" string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved"
                        domain="[('status','=','approved')]"/>
                <filter name="rework" string="Rework"
                        domain="[('status','=','rework')]"/>
                <filter name="rejected" string="Rejected"
                        domain="[('status','=','rejected')]"/>
                <filter name="failed" string="API Failed"
                        domain="[('state','=','failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'create_date:day'}"/>
                    <filter name="group_user" string="Analyst"
                            context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
