<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard View: Input QC Lab Data -->
    <record id="view_create_kbr_wizard_form" model="ir.ui.view">
        <field name="name">create.kbr.decision.wizard.form</field>
        <field name="model">create.kbr.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Create KBR QC Decision">
                <group>
                    <group string="Production Info">
                        <field name="production_id" readonly="1"/>
                        <field name="batch_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="qty_produced" readonly="1"/>
                    </group>
                    <group string="QC Lab Results">
                        <field name="ph_level" required="1"/>
                        <field name="ph_min" readonly="1"/>
                        <field name="ph_max" readonly="1"/>
                        <field name="viscosity" required="1"/>
                        <field name="visc_min" readonly="1"/>
                        <field name="visc_max" readonly="1"/>
                    </group>
                </group>
                <footer>
                    <button name="create_and_submit"
                            string="Submit to KBR Engine"
                            type="object"
                            class="oe_highlight"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action: Open Wizard -->
    <record id="action_create_kbr_decision" model="ir.actions.act_window">
        <field name="name">Create KBR Decision</field>
        <field name="res_model">create.kbr.decision.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>
