<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Embed KBR Status widget ke Production Order form -->

    <record id="view_mrp_production_kbr_form" model="ir.ui.view">
        <field name="name">mrp.production.kbr.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Tambah button Create KBR Decision -->
            <button name="action_cancel" position="before">
                <button name="%(action_create_kbr_decision)d"
                        string="Create QC Decision"
                        type="action"
                        class="btn-primary"
                        invisible="state in ('done', 'cancel')"/>
            </button>

            <!-- Tambah tab KBR Decisions -->
            <notebook position="inside">
                <page string="KBR QC Decisions"
                      name="kbr_decisions"
                      invisible="not kbr_decision_ids">
                    <field name="kbr_decision_ids"
                           readonly="1"
                           context="{'default_production_id': active_id}">
                        <tree decoration-success="status=='approved'"
                              decoration-danger="status=='rejected'"
                              decoration-warning="status=='rework'">
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="ph_level"/>
                            <field name="viscosity"/>
                            <field name="status"
                                   widget="badge"
                                   decoration-success="status=='approved'"
                                   decoration-warning="status=='rework'"
                                   decoration-danger="status=='rejected'"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </notebook>

            <!-- Tambah KBR status badge di header -->
            <field name="state" position="after">
                <field name="kbr_latest_status"
                       widget="badge"
                       decoration-success="kbr_latest_status=='approved'"
                       decoration-warning="kbr_latest_status=='rework'"
                       decoration-danger="kbr_latest_status=='rejected'"
                       invisible="not kbr_latest_status"
                       readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
